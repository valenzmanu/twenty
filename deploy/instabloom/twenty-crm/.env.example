# This file documents the remote .env shape.
# Do not commit the real .env.

TAG=v2.9.0
SERVER_URL=https://crm.instabloom.gt
STORAGE_TYPE=local

PG_DATABASE_USER=twenty
PG_DATABASE_PASSWORD=replace_with_random_secret
PG_DATABASE_HOST=db
PG_DATABASE_PORT=5432
REDIS_URL=redis://redis:6379

# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=replace_with_random_secret
FALLBACK_ENCRYPTION_KEY=
APP_SECRET=replace_with_random_secret

CLOUDFLARE_TUNNEL_TOKEN=replace_with_cloudflare_tunnel_token

AUTH_PASSWORD_ENABLED=true
IS_EMAIL_VERIFICATION_REQUIRED=false
EMAIL_DRIVER=smtp
EMAIL_FROM_ADDRESS=noreply@instabloom.gt
EMAIL_FROM_NAME=InstaBloom CRM
EMAIL_SMTP_HOST=smtp.resend.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=resend
EMAIL_SMTP_PASSWORD=replace_with_resend_api_key
EMAIL_SMTP_NO_TLS=false

TWENTY_ADMIN_EMAIL=mantt89.mv@gmail.com
